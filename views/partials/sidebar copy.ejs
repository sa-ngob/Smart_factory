            // --- Logic การแสดงผล ---
            const accessibleUrls = new Set(accessiblePages.map(p => p.url));

            menuStructure.forEach(group => {
                const hasVisibleItems = group.items.some(item => {
                    if (item.children) {
                        return item.children.some(child => accessibleUrls.has(child.url));
                    } else {
                        return accessibleUrls.has(item.url);
                    }
                });

                if (hasVisibleItems) { %>
                    <li class="nav-header text-muted"><%- group.header %></li>
                <% }

                group.items.forEach(item => {
                    if (item.children) {
                        const visibleChildren = item.children.filter(child => accessibleUrls.has(child.url));
                        if (visibleChildren.length > 0) { %>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown" data-bs-auto-close="false" role="button" aria-expanded="false">
                                    <span class="nav-link-icon d-md-none d-lg-inline-block"><%- item.icon %></span>
                                    <span class="nav-link-title"><%- item.name %></span>
                                </a>
                                <div class="dropdown-menu">
                                    <% visibleChildren.forEach(child => { %>
                                        <a class="dropdown-item" href="<%- child.url %>"><%- child.name %></a>
                                    <% }); %>
                                </div>
                            </li>
                        <% }
                    } else {
                        if (accessibleUrls.has(item.url)) { %>
                            <li class="nav-item">
                                <a class="nav-link" href="<%- item.url %>">
                                    <span class="nav-link-icon d-md-none d-lg-inline-block"><%- item.icon %></span>
                                    <span class="nav-link-title"><%- item.name %></span>
                                </a>
                            </li>
                        <% }
                    }
                });
            });
            %>

